#!/bin/bash
# Clone Prezto, or update it when already there. run_ (every apply) so it stays
# current; never aborts the apply — a failed update leaves the existing
# checkout in place.
set -uo pipefail

PREZTO="{{ .chezmoi.homeDir }}/.zprezto"

if [ ! -d "$PREZTO" ]; then
  git clone --recursive https://github.com/sorin-ionescu/prezto.git "$PREZTO" ||
    echo "prezto: clone failed, the next chezmoi apply retries it" >&2
  exit 0
fi

# Same steps as Prezto's own zprezto-update
if ! { git -C "$PREZTO" pull --ff-only --quiet &&
  git -C "$PREZTO" submodule sync --quiet --recursive &&
  git -C "$PREZTO" submodule update --init --recursive --quiet; }; then
  echo "prezto: update failed, keeping the current checkout" >&2
fi
exit 0
