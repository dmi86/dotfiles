#!/bin/bash
# Register the JDKs from packages.yaml with jenv, so `jenv local <version>`
# works without a manual `jenv add`. run_onchange_: the paths below are the
# rendered content, so this re-runs exactly when a JDK is added or removed.
# The opt/ paths survive upgrades, and jenv add skips JDKs it already knows.
set -uo pipefail

command -v jenv >/dev/null 2>&1 || exit 0

for home in \
{{- range .brew.formulae }}{{ if hasPrefix "openjdk" . }}
  "$(brew --prefix)/opt/{{ . }}/libexec/openjdk.jdk/Contents/Home" \
{{- end }}{{ end }}
{{- range .brew.casks }}{{ if hasPrefix "microsoft-openjdk@" . }}
  "/Library/Java/JavaVirtualMachines/microsoft-{{ trimPrefix "microsoft-openjdk@" . }}.jdk/Contents/Home" \
{{- end }}{{ end }}
  ; do
  [ -x "$home/bin/java" ] && jenv add "$home" >/dev/null 2>&1
done
exit 0
