#!/bin/bash
{{/* The bootstrap script embedded verbatim, rather than invoked from
     ~/.local/bin — because run_onchange_ keys off the rendered content,
     editing either the script or .chezmoidata/leapp.yaml re-runs this on its
     own, with no sha256sum marker to keep in sync.

     It is run as its own bash process from a temp file so its `set -e` still
     applies inside it, while a failure only prints a warning instead of
     aborting the apply (the lm-build and Dock steps run after this one).

     Run with no arguments, so DO_LOGIN stays 0: the SSO login opens a browser
     and must not block an apply. Everything that can be done offline is done
     here; the output says what is left (leapp-bootstrap --login). */ -}}
script=$(mktemp)
trap 'rm -f "$script"' EXIT
cat >"$script" <<'LEAPP_BOOTSTRAP'
{{ includeTemplate "leapp-bootstrap.sh" . }}
LEAPP_BOOTSTRAP

bash "$script" ||
  echo "leapp-bootstrap: failed — run 'leapp-bootstrap' to retry (chezmoi apply will not re-run this)" >&2
exit 0
