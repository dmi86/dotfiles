#!/bin/bash
# Register the JDKs from packages.yaml with jenv, so `jenv local 17` works on a
# fresh machine without the manual `jenv add` step.
#
# run_after_ (every apply), so a JDK added or upgraded by run_20-install-packages
# is picked up on the same apply. Already-registered JDKs are skipped, and
# nothing here aborts the apply.
#
# The Homebrew formulae (openjdk@17, openjdk@21) are keg-only and live under
# their opt/ path, which survives upgrades. The casks (microsoft-openjdk@11)
# install into /Library/Java/JavaVirtualMachines.
set -uo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"

command -v jenv >/dev/null 2>&1 || exit 0

homes=(
{{- range .brew.formulae }}{{ if hasPrefix "openjdk" . }}
  "$HOMEBREW_PREFIX/opt/{{ . }}/libexec/openjdk.jdk/Contents/Home"
{{- end }}{{ end }}
)
for home in /Library/Java/JavaVirtualMachines/*/Contents/Home; do
  [ -d "$home" ] && homes+=("$home")
done

# jenv keeps one symlink per registered alias in ~/.jenv/versions
registered=" $(for v in "$HOME"/.jenv/versions/*; do [ -L "$v" ] && readlink "$v"; done | tr '\n' ' ') "

added=""
for home in "${homes[@]}"; do
  [ -x "$home/bin/java" ] || continue
  case "$registered" in *" $home "*) continue ;; esac
  # jenv add exits non-zero when only its final shim rehash fails, after the
  # JDK was already registered; that is checked below instead.
  jenv add "$home" >/dev/null 2>&1
  added+=" $home"
done

[ -n "$added" ] || exit 0

echo "==> jenv: registered$(for h in $added; do printf ' %s' "$("$h/bin/java" -version 2>&1 | awk -F'"' 'NR==1 { print $2 }')"; done)"
if ! jenv rehash >/dev/null 2>&1; then
  echo "    ! jenv rehash failed. If no jenv command is running, a stale lock is left over:" >&2
  echo "      run 'jenv rehash --force'" >&2
fi
exit 0
