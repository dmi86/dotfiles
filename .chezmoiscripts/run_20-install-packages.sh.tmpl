#!/bin/bash
# Install and upgrade everything in .chezmoidata/packages.yaml with
# `brew bundle`, which installs what is missing, upgrades what is outdated
# and carries on past a failed entry. Edit the data file, not this.
#
# run_ (every apply), not run_onchange_, so outdated packages are upgraded on
# every apply rather than only when the list changes. A failed entry (e.g. an
# app installed by hand before the first apply) is reported by brew bundle and
# must not abort the apply.
set -uo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"

brew bundle install --file=- <<'BREWFILE' ||
{{- range .brew.formulae }}
{{- $parts := splitList "/" . }}{{ if eq (len $parts) 3 }}
tap {{ $parts | initial | join "/" | quote }}
{{- end }}
{{- end }}
{{- range .brew.formulae }}
brew {{ . | quote }}
{{- end }}
{{- range .brew.casks }}
cask {{ . | quote }}
{{- end }}
{{- range .vscodeExtensions }}
vscode {{ . | quote }}
{{- end }}
BREWFILE
  echo "brew bundle: some packages failed (listed above); the next chezmoi apply retries them" >&2
exit 0
